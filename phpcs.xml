<?xml version="1.0"?>
<ruleset name="CodeIgniter4">
    <description>The CodeIgniter4 coding standard.</description>
    <file>app</file>
    <file>tests</file>

    <!-- Use the PSR12 Coding Standard -->
    <rule ref="PSR12"/>

    <!-- Configure line length warning to 120, and error to 150 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>

    <!-- Ignore missing doc comments for test files -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>app/Config/*</exclude-pattern>
        <exclude-pattern>app/Database/*</exclude-pattern>
        <exclude-pattern>app/Filters/*</exclude-pattern>
        <exclude-pattern>app/Helpers/*</exclude-pattern>
        <exclude-pattern>app/Libraries/*</exclude-pattern>
        <exclude-pattern>app/Models/*</exclude-pattern>
        <exclude-pattern>app/Controllers/*</exclude-pattern>
        <exclude-pattern>app/Common.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.ClassComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>app/Config/*</exclude-pattern>
        <exclude-pattern>app/Database/*</exclude-pattern>
        <exclude-pattern>app/Filters/*</exclude-pattern>
        <exclude-pattern>app/Helpers/*</exclude-pattern>
        <exclude-pattern>app/Libraries/*</exclude-pattern>
        <exclude-pattern>app/Models/*</exclude-pattern>
        <exclude-pattern>app/Controllers/*</exclude-pattern>
        <exclude-pattern>app/Common.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>app/Config/*</exclude-pattern>
        <exclude-pattern>app/Database/*</exclude-pattern>
        <exclude-pattern>app/Filters/*</exclude-pattern>
        <exclude-pattern>app/Helpers/*</exclude-pattern>
        <exclude-pattern>app/Libraries/*</exclude-pattern>
        <exclude-pattern>app/Models/*</exclude-pattern>
        <exclude-pattern>app/Controllers/*</exclude-pattern>
        <exclude-pattern>app/Common.php</exclude-pattern>
    </rule>
    <!-- Ignore missing doc comments for view files -->
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>app/Views/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>app/Views/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.ClassComment.Missing">
        <exclude-pattern>app/Views/*</exclude-pattern>
    </rule>

</ruleset>